{
  "expo": {
    "name": "MyGroceryListTracker",
    "slug": "MyGroceryListTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2e7d32"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.Melvsanity.mygrocerylisttracker"
    },
    "android": {
      "package": "com.Melvsanity.mygrocerylisttracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2e7d32"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "b5d9b6a6-4a33-4dd0-8523-a0cf1670b9cd"
      }
    },
    "owner": "melvsanity"
  }
}
